# Copy to .env. Generate secrets with: openssl rand -base64 36

REGISTRY_POSTGRES_PASSWORD=
# Bootstrap administrator token (at least 32 characters). Use it to create
# namespaces, tokens and upstreams, then keep it out of day-to-day use.
REGISTRY_ADMIN_TOKEN=

# private (sign-in required to read) or public (anonymous reads).
REGISTRY_MODE=private
# External URL of the registry, as clients reach it.
REGISTRY_PUBLIC_URL=http://localhost:8080
REGISTRY_BIND=127.0.0.1:8080

# Optional: read-only GitHub token for importing and indexing from GitHub.
REGISTRY_GITHUB_TOKEN=

# Optional: upstream registries on private networks, and their tokens.
REGISTRY_UPSTREAM_ALLOW_CIDRS=
REGISTRY_UPSTREAM_ALLOW_HTTP=false
REGISTRY_UPSTREAM_TOKEN_HUB=
REGISTRY_TRUSTED_PROXIES=
